+}
+// TESTBUILD：遍历对象树。needle == nullptr：打印 TB_UI_NEEDLES 里的 label 的坐标 / 是否可见 / 文字颜色 / 可不可点；
+// 否则返回第一个可见的、文字等于 needle（exact）或以 needle 开头的 label。
+static lv_obj_t* tb_ui_walk(lv_obj_t* o, bool hidden, const char* needle, bool exact = false)
+{
+    hidden = hidden || lv_obj_has_flag(o, LV_OBJ_FLAG_HIDDEN);
+    if (lv_obj_check_type(o, &lv_label_class)) {
+        const char* t = lv_label_get_text(o);
+        if (t && needle) {
+            if (!hidden && (exact ? strcmp(t, needle) == 0 : strncmp(t, needle, strlen(needle)) == 0)) return o;
+        } else if (t) {
+            for (const char* nd : TB_UI_NEEDLES) {
+                if (strncmp(t, nd, strlen(nd)) != 0) continue;
+                lv_area_t a;
+                lv_obj_get_coords(o, &a);
+                lv_color_t c = lv_obj_get_style_text_color(o, LV_PART_MAIN);
+                ESP_LOGW(TAG, "TESTBUILD uifind: %s  x %d~%d  y %d~%d  %s  颜色 %02x%02x%02x  %s",
+                         tb_ui_name(t), (int)a.x1, (int)a.x2, (int)a.y1, (int)a.y2, hidden ? "隐藏" : "可见",
+                         c.red, c.green, c.blue,
+                         lv_obj_has_flag(o, LV_OBJ_FLAG_CLICKABLE) ? "可点" : "");
+                break;
+            }
+        }
+    }
+    uint32_t n = lv_obj_get_child_count(o);
+    for (uint32_t i = 0; i < n; i++) {
+        lv_obj_t* r = tb_ui_walk(lv_obj_get_child(o, i), hidden, needle, exact);
+        if (r) return r;
+    }
+    return nullptr;
