+static const char* tb_ui_name(const char* t)
+{
+    if (strcmp(t, LV_SYMBOL_WARNING) == 0)   return "<警告图标>";
+    if (strcmp(t, LV_SYMBOL_WIFI) == 0)      return "<WiFi图标>";
+    if (strcmp(t, LV_SYMBOL_SETTINGS) == 0)  return "<齿轮图标>";
